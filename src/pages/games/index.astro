---
import GameCloudPanel from "@/components/GameCloudPanel.astro";
import PageHeader from "@/components/PageHeader.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout title="小游戏" description="小游戏 - 休息一下，摸鱼专用">
	<div class="page-shell card-base">
		<PageHeader
			title="小游戏"
			description="摸鱼专用，本地自动存档；登录后可以跨设备保存和恢复。"
			meta="3 款小游戏"
		/>
		<GameCloudPanel />

		<section class="game-player" aria-labelledby="game-player-title">
			<div class="game-section-heading">
				<h2 id="game-player-title">选择游戏</h2>
				<p>切换后将在下方打开，本地进度仍会保留。</p>
			</div>
			<div class="game-tabs" role="group" aria-label="选择小游戏">
				<button
					type="button"
					class="game-tab"
					data-game-tab
					aria-pressed="true"
					aria-controls="gameFrame"
					onclick="document.getElementById('gameFrame').src='/games/farm.html'; document.querySelectorAll('[data-game-tab]').forEach((tab) => tab.setAttribute('aria-pressed', String(tab === this))); document.getElementById('gameFrame').title='种菜小游戏';"
				>
					<span class="game-tab-emoji" aria-hidden="true">🌱</span>
					<span>种菜</span>
					<span class="game-tab-check" aria-hidden="true">✓</span>
				</button>
				<button
					type="button"
					class="game-tab"
					data-game-tab
					aria-pressed="false"
					aria-controls="gameFrame"
					onclick="document.getElementById('gameFrame').src='/games/xiuxian.html'; document.querySelectorAll('[data-game-tab]').forEach((tab) => tab.setAttribute('aria-pressed', String(tab === this))); document.getElementById('gameFrame').title='放置修仙小游戏';"
				>
					<span class="game-tab-emoji" aria-hidden="true">⚡</span>
					<span>放置修仙</span>
					<span class="game-tab-check" aria-hidden="true">✓</span>
				</button>
				<button
					type="button"
					class="game-tab"
					data-game-tab
					aria-pressed="false"
					aria-controls="gameFrame"
					onclick="document.getElementById('gameFrame').src='/games/parking.html'; document.querySelectorAll('[data-game-tab]').forEach((tab) => tab.setAttribute('aria-pressed', String(tab === this))); document.getElementById('gameFrame').title='抢车位小游戏';"
				>
					<span class="game-tab-emoji" aria-hidden="true">🅿️</span>
					<span>抢车位</span>
					<span class="game-tab-check" aria-hidden="true">✓</span>
				</button>
			</div>
			<div class="game-stage">
				<iframe id="gameFrame" src="/games/farm.html" title="种菜小游戏" class="game-frame"></iframe>
			</div>
		</section>
	</div>
</MainGridLayout>

<style>
	.page-shell {
		position: relative;
		width: 100%;
		min-width: 0;
		min-height: 8rem;
		padding: clamp(1.35rem, 3vw, 2.25rem);
		border: 1px solid var(--border-subtle);
		background: var(--surface-solid);
		box-shadow: var(--shadow-card);
		color: var(--text-strong);
	}
	.game-player { min-width: 0; }
	.game-section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}
	.game-section-heading h2 {
		margin: 0;
		color: var(--text-strong);
		font-size: 1rem;
		font-weight: 750;
	}
	.game-section-heading p {
		margin: 0;
		color: var(--text-subtle);
		font-size: 0.76rem;
		line-height: 1.6;
	}
	.game-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		margin: 0.85rem 0 1rem;
	}
	.game-tab {
		display: inline-flex;
		flex: 1 1 9rem;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		min-width: 0;
		min-height: 2.75rem;
		padding: 0.65rem 0.85rem;
		border: 1px solid var(--border-subtle);
		border-radius: 0.75rem;
		background: var(--surface-muted);
		color: var(--text-muted);
		font-family: inherit;
		font-size: 0.84rem;
		font-weight: 700;
		line-height: 1.3;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background-color var(--duration-fast) ease,
			border-color var(--duration-fast) ease,
			color var(--duration-fast) ease,
			box-shadow var(--duration-fast) ease;
	}
	.game-tab:hover {
		border-color: var(--border-strong);
		color: var(--text-strong);
	}
	.game-tab[aria-pressed="true"] {
		border-color: var(--accent-fill);
		background: var(--accent-fill);
		color: var(--on-accent);
		box-shadow: var(--shadow-card);
	}
	.game-tab:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 3px;
	}
	.game-tab-emoji { font-size: 1rem; line-height: 1; }
	.game-tab-check {
		display: grid;
		place-items: center;
		width: 1rem;
		height: 1rem;
		margin-left: 0.1rem;
		border: 1px solid currentColor;
		border-radius: 50%;
		font-size: 0.65rem;
		line-height: 1;
		visibility: hidden;
	}
	.game-tab[aria-pressed="true"] .game-tab-check { visibility: visible; }
	.game-stage {
		overflow: hidden;
		border: 1px solid var(--border-strong);
		border-radius: 1rem;
		background: var(--surface-muted);
	}
	.game-frame {
		display: block;
		width: 100%;
		height: clamp(28rem, 76vh, 52rem);
		height: clamp(28rem, 76dvh, 52rem);
		border: 0;
		background: var(--surface-muted);
	}
	@media (max-width: 640px) {
		.page-shell { padding: 1.25rem 1rem; }
		.game-section-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.25rem;
		}
		.game-tab { flex-basis: 8rem; padding-inline: 0.65rem; }
		.game-frame {
			height: clamp(25rem, 70vh, 42rem);
			height: clamp(25rem, 70dvh, 42rem);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.game-tab { transition: none; }
	}
</style>