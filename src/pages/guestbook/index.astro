---
import Giscus from "@/components/Giscus.astro";
import PageHeader from "@/components/PageHeader.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout title="留言板" description="留言板 - 欢迎留下你的想法">
	<div class="page-shell card-base">
		<PageHeader
			title="留言板"
			description="欢迎留下你的想法、问题或反馈。评论通过 GitHub Discussions 加载，登录 GitHub 后即可参与。"
			meta="GitHub Discussions"
		/>
		<section class="guestbook-thread" aria-label="留言区">
			<div class="guestbook-loading" role="status" aria-live="polite">
				<span class="loading-indicator" aria-hidden="true"></span>
				<div class="loading-copy">
					<strong>留言区正在加载</strong>
					<p>首次连接 GitHub Discussions 可能需要片刻。</p>
				</div>
			</div>
			<!-- 占位的 repoId / categoryId 记得替换成 giscus.app 给的真实值 -->
			<Giscus
				repo="649082922/649082922.github.io"
				repoId="R_kgDOLxxxxx"
				category="Announcements"
				categoryId="DIC_kwDOLxxxxx"
				mapping="pathname"
			/>
		</section>
	</div>
</MainGridLayout>

<style>
	.page-shell {
		position: relative;
		width: 100%;
		min-width: 0;
		min-height: 8rem;
		padding: clamp(1.35rem, 3vw, 2.25rem);
		border: 1px solid var(--border-subtle);
		background: var(--surface-solid);
		box-shadow: var(--shadow-card);
		color: var(--text-strong);
	}
	.guestbook-thread { min-width: 0; }
	.guestbook-loading {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		min-height: 7rem;
		margin-bottom: 1rem;
		padding: 1.1rem 1.2rem;
		border: 1px solid var(--border-subtle);
		border-radius: 0.9rem;
		background: var(--surface-muted);
	}
	.loading-indicator {
		flex: none;
		width: 1.3rem;
		height: 1.3rem;
		border: 2px solid var(--border-strong);
		border-top-color: var(--accent-text);
		border-radius: 50%;
		animation: guestbook-spin 0.9s linear infinite;
	}
	.loading-copy { min-width: 0; }
	.loading-copy strong {
		display: block;
		color: var(--text-strong);
		font-size: 0.88rem;
		font-weight: 700;
	}
	.loading-copy p {
		margin: 0.3rem 0 0;
		color: var(--text-muted);
		font-size: 0.78rem;
		line-height: 1.6;
	}
	:global(.guestbook-thread:has(.giscus-frame) > .guestbook-loading) {
		display: none;
	}
	@keyframes guestbook-spin {
		to { transform: rotate(360deg); }
	}
	@media (max-width: 640px) {
		.page-shell { padding: 1.25rem 1rem; }
		.guestbook-loading { padding: 1rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.loading-indicator { animation: none; }
	}
</style>