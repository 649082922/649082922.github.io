---
import PageHeader from "@/components/PageHeader.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const scripts = [
	{
		title: "os_db_version_check 巡检脚本",
		tag: "Linux/AIX · 巡检",
		desc: "批量探测主机操作系统与数据库版本，AIX/Linux 自适应，输出 CSV 便于汇总盘点。",
		href: "/posts/os_db_version_check/",
	},
	{
		title: "批量 SSH 互信脚本",
		tag: "Linux · 效率",
		desc: "多节点批量配置互信，支持各节点不同密码的进阶版本，装集群前必备。",
		href: "/posts/互信脚本1.0/",
	},
	{
		title: "RMAN 备份脚本",
		tag: "Oracle · 备份",
		desc: "归档删除策略、快照控制文件路径与全备脚本组织方式，生产环境长期使用的套路。",
		href: "/posts/linux下rman脚本/",
	},
	{
		title: "批量导出数据到 Excel",
		tag: "Oracle · 导数",
		desc: "大结果集批量落 Excel 的实用做法，交付报表类需求省去逐次手工导出。",
		href: "/posts/批量导出O到excel/",
	},
	{
		title: "SQL 绑定变量提取与替换",
		tag: "Oracle · 调优",
		desc: "把抓到的 SQL 原文还原成绑定变量形式，性能比对与改写时的省力工具。",
		href: "/posts/替换sql绑定变量/",
	},
	{
		title: "端口占用排查与清理",
		tag: "Linux · 排障",
		desc: "定位占用端口的进程并安全清理，起服务冲突时的一分钟解法。",
		href: "/posts/端口号被占用kill/",
	},
	{
		title: "OB 不常用租户清理",
		tag: "OceanBase · 治理",
		desc: "识别长期闲置租户并安全回收资源的操作清单，云环境成本治理常用。",
		href: "/posts/清理不常用租户/",
	},
	{
		title: "达梦装库脚本",
		tag: "达梦 · 部署",
		desc: "DM 数据守护集群一键建库的脚本化记录，参数按环境替换后可直接复用。",
		href: "/posts/装库脚本笔记/",
	},
	{
		title: "分区表在线重定义",
		tag: "Oracle · 改造",
		desc: "大表在线重定义改造分区表的完整步骤与风险点核对清单。",
		href: "/posts/在线重定义分区表/",
	},
];

const snippet = `#!/bin/sh
# 批量检查主机 OS 与数据库版本，输出 CSV
IP_LIST=($(< ipfile.txt))
CSV_FILE="OS_check_$(date +'%F_%H%M%S').csv"
echo "check_type,IP,os,db_version" > "$CSV_FILE"

# 探测逻辑：AIX 走 oslevel，Linux 读 os-release / libc 版本推断 6/7/8
if [ "$(uname -s)" = "AIX" ]; then
    pretty_name="$(uname) $(oslevel)"
else
    pretty_name=$(grep '^PRETTY_NAME=' /etc/os-release | cut -d'"' -f2)
    libc_version=$(ldd --version | head -n 1 | awk '{print $NF}' | cut -d '.' -f 2)
fi
# 逐台采集并追加 CSV（完整脚本见笔记）`;
---

<MainGridLayout title="软件&脚本" description="可复用的运维脚本与效率工具精选">
	<div class="page-shell card-base">
		<PageHeader
			title="软件 & 脚本"
			description="生产环境长期使用、可复用的脚本与工具精选。点击卡片查看完整笔记。"
			meta={`${scripts.length} 个精选脚本`}
		>
			<a slot="actions" class="repo-link" target="_blank" rel="noopener"
				href="https://github.com/649082922/dba-notes">
				完整脚本库 · dba-notes
			</a>
		</PageHeader>

		<div class="script-grid">
			{
				scripts.map((s) => (
					<a href={s.href} class="script-card">
						<span class="script-tag">{s.tag}</span>
						<h2>{s.title}</h2>
						<p>{s.desc}</p>
						<span class="script-link">查看笔记</span>
					</a>
				))
			}
		</div>

		<details class="snippet-box">
			<summary>os_db_version_check 核心片段</summary>
			<pre><code>{snippet}</code></pre>
		</details>
	</div>
</MainGridLayout>

<style>
	.page-shell {
		position: relative;
		width: 100%;
		min-width: 0;
		min-height: 8rem;
		padding: clamp(1.35rem, 3vw, 2.25rem);
		border: 1px solid var(--border-subtle);
		background: var(--surface-solid);
		box-shadow: var(--shadow-card);
		color: var(--text-strong);
	}
	.repo-link {
		display: inline-flex;
		min-height: 44px;
		align-items: center;
		padding: 0 1rem;
		border: 1px solid var(--border-subtle);
		border-radius: 999px;
		background: var(--surface-muted);
		color: var(--text-muted);
		font-size: 0.82rem;
		font-weight: 700;
		white-space: nowrap;
		transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
	}
	.repo-link:hover {
		border-color: color-mix(in srgb, var(--primary) 36%, transparent);
		color: var(--accent-text);
	}
	.script-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr));
		gap: 0.9rem;
		margin-bottom: 1.5rem;
	}
	.script-card {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		min-width: 0;
		padding: 1.05rem 1.1rem;
		border: 1px solid var(--border-subtle);
		border-radius: 0.9rem;
		background: var(--surface-muted);
		color: var(--text-strong);
		transition:
			border-color var(--duration-fast) ease,
			background var(--duration-fast) ease,
			transform var(--duration-fast) ease,
			box-shadow var(--duration-fast) ease;
	}
	.script-card:hover {
		border-color: color-mix(in srgb, var(--primary) 34%, transparent);
		background: var(--surface-solid);
		box-shadow: var(--shadow-card);
		transform: translateY(-2px);
	}
	.script-card:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 3px;
	}
	.script-tag {
		color: var(--accent-text);
		font-size: 0.7rem;
		font-weight: 700;
	}
	.script-card h2 {
		margin: 0;
		color: var(--text-strong);
		font-size: 1rem;
		font-weight: 750;
		line-height: 1.5;
		letter-spacing: -0.01em;
	}
	.script-card p {
		margin: 0;
		flex: 1;
		color: var(--text-muted);
		font-size: 0.8rem;
		line-height: 1.65;
	}
	.script-link {
		color: var(--accent-text);
		font-size: 0.76rem;
		font-weight: 700;
	}
	.script-card:hover .script-link { text-decoration: underline; text-underline-offset: 3px; }
	.snippet-box {
		padding: 0.9rem 1.1rem;
		border: 1px solid var(--border-subtle);
		border-radius: 0.9rem;
		background: var(--surface-muted);
		font-size: 0.85rem;
	}
	.snippet-box summary {
		cursor: pointer;
		color: var(--text-strong);
		font-weight: 700;
	}
	.snippet-box summary:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 3px;
	}
	.snippet-box pre {
		overflow-x: auto;
		margin-top: 0.8rem;
		padding: 0.9rem;
		border-radius: 0.6rem;
		background: var(--codeblock-bg);
		color: #e8eaf0;
		font-size: 0.75rem;
		line-height: 1.6;
	}
	@media (max-width: 640px) {
		.page-shell { padding: 1.25rem 1rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.script-card { transition: none; }
		.script-card:hover { transform: none; }
	}
</style>
