---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout title="题库" description="新建或上传自己的题库，再开始答题">
	<section class="library-page onload-animation">
		<header class="page-head">
			<p>QUESTION LIBRARY</p>
			<h1>先准备题库，再开始答题</h1>
			<span>网站不再预装题目。你可以直接新建题库，也可以导入本地 JSON 文件；题库和答题记录只保存在当前浏览器。</span>
		</header>

		<div class="library-grid">
			<section class="bank-card current" id="current-bank-card" hidden>
				<span class="bank-tag">当前题库</span>
				<strong id="current-bank-name">我的题库</strong>
				<small id="current-bank-summary"></small>
				<div class="card-actions">
					<a class="primary-action" href="/quiz/">继续答题</a>
					<button id="edit-bank" type="button">编辑</button>
					<button id="clear-bank" type="button">清空</button>
				</div>
			</section>

			<button class="bank-card" id="new-bank" type="button">
				<span class="bank-tag">从零开始</span>
				<strong>新建题库</strong>
				<small>填写题库名称，再逐题添加单选、多选或判断题。</small>
				<div class="bank-meta"><b>网页内编辑</b><i>开始新建 →</i></div>
			</button>

			<label class="bank-card upload" for="quiz-file">
				<span class="bank-tag">本地文件</span>
				<strong>上传题库</strong>
				<small>支持 JSON 文件，校验成功后会保存为当前题库并进入答题。</small>
				<div class="bank-meta"><b>最大 4 MB</b><i>选择文件 →</i></div>
				<input id="quiz-file" type="file" accept=".json,application/json" />
			</label>
		</div>

		<section class="bank-editor" id="bank-editor" hidden>
			<div class="editor-head">
				<div><span>题库编辑器</span><h2 id="editor-title">新建题库</h2></div>
				<button id="cancel-edit" type="button">收起</button>
			</div>

			<label class="field bank-name-field">
				<span>题库名称</span>
				<input id="bank-name" maxlength="60" placeholder="例如：数据库基础练习" />
			</label>

			<div class="question-form">
				<label class="field">
					<span>题型</span>
					<select id="question-type">
						<option value="single">单选题</option>
						<option value="multiple">多选题</option>
						<option value="judge">判断题</option>
					</select>
				</label>
				<label class="field question-field">
					<span>题目</span>
					<textarea id="question-text" rows="3" placeholder="输入题目内容"></textarea>
				</label>
				<label class="field options-field" id="options-field">
					<span>选项（每行一个，不用填写 A、B）</span>
					<textarea id="question-options" rows="4" placeholder="第一个选项&#10;第二个选项"></textarea>
				</label>
				<label class="field answer-field">
					<span id="answer-label">答案字母</span>
					<input id="question-answer" maxlength="6" placeholder="A；多选可填 AB" />
				</label>
				<button class="add-question" id="add-question" type="button">添加这道题</button>
			</div>

			<p class="editor-status" id="editor-status" aria-live="polite"></p>
			<div class="draft-summary" id="draft-summary">还没有题目</div>
			<div class="draft-list" id="draft-list"></div>
			<div class="editor-actions">
				<button id="save-bank" type="button">仅保存题库</button>
				<button class="primary-action" id="save-and-start" type="button">保存并开始答题</button>
			</div>
		</section>

		<div class="format-note">
			<div>
				<strong>上传文件格式</strong>
				<span>支持 single、multiple、judge 三类题目，answer 使用 A–F 字母。</span>
			</div>
			<code>{`{"single":[{"q":"题目","options":["A项","B项"],"answer":"A"}],"multiple":[],"judge":[]}`}</code>
		</div>
		<p class="upload-status" id="upload-status" aria-live="polite"></p>
	</section>
</MainGridLayout>

<style>
	.library-page {
		--library-text: #25211e;
		--library-muted: #746d65;
		--library-subtle: #948b82;
		--library-line: rgba(37, 33, 30, 0.14);
		padding: clamp(1.2rem, 3vw, 2.6rem);
		border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent);
		border-radius: 1.35rem;
		background: var(--card-bg);
		color: var(--library-text);
	}
	:global(.dark) .library-page {
		--library-text: #f7f1ec;
		--library-muted: #cec3bb;
		--library-subtle: #aaa098;
		--library-line: rgba(255, 244, 235, 0.17);
	}
	[hidden] { display: none !important; }
	.page-head { max-width: 55rem; }
	.page-head p { margin: 0 0 .8rem; color: var(--primary); font: 800 .72rem/1 ui-monospace, Consolas, monospace; letter-spacing: .14em; }
	.page-head h1 { margin: 0; font-size: clamp(2rem, 5vw, 3.6rem); line-height: 1.08; letter-spacing: -.05em; color: var(--library-text); }
	.page-head > span { display: block; margin-top: 1rem; font-size: .95rem; line-height: 1.75; color: var(--library-muted); }
	.library-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: clamp(.8rem, 1.6vw, 1.2rem); margin-top: clamp(1.6rem, 3vw, 2.4rem); }
	.bank-card { min-height: 14rem; padding: clamp(1.15rem, 2vw, 1.65rem); border: 1px solid var(--library-line); border-radius: 1rem; background: color-mix(in srgb, var(--card-bg) 94%, var(--primary)); color: var(--library-text); text-align: left; cursor: pointer; display: flex; flex-direction: column; font: inherit; transition: transform 160ms ease, border-color 160ms ease, background 160ms ease; }
	.bank-card:hover { transform: translateY(-2px); border-color: var(--primary); background: color-mix(in srgb, var(--primary) 6%, var(--card-bg)); }
	.bank-card.current { cursor: default; }
	.bank-tag { width: max-content; padding: .34rem .58rem; border-radius: .4rem; background: color-mix(in srgb, var(--primary) 13%, transparent); color: var(--primary); font-size: .68rem; font-weight: 800; }
	.bank-card strong { margin-top: 1.25rem; font-size: clamp(1.12rem, 2vw, 1.4rem); color: var(--library-text); }
	.bank-card small { max-width: 32rem; margin-top: .6rem; font-size: .82rem; line-height: 1.65; color: var(--library-muted); }
	.bank-meta, .card-actions { margin-top: auto; padding-top: 1.25rem; display: flex; align-items: center; justify-content: space-between; gap: .65rem; font-size: .76rem; }
	.bank-meta b { color: var(--library-subtle); font-weight: 650; }
	.bank-meta i { color: var(--primary); font-style: normal; font-weight: 800; }
	.bank-card input[type="file"] { display: none; }
	.card-actions { justify-content: flex-start; flex-wrap: wrap; }
	.card-actions a, .card-actions button, .editor-actions button, .add-question, .editor-head button { border: 1px solid var(--library-line); border-radius: .55rem; padding: .62rem .82rem; background: transparent; color: var(--library-text); cursor: pointer; font: 700 .75rem/1 inherit; text-decoration: none; }
	.primary-action { border-color: var(--primary) !important; background: var(--primary) !important; color: var(--btn-content) !important; }
	.bank-editor { margin-top: 1.2rem; padding: clamp(1rem, 2.5vw, 1.6rem); border: 1px solid var(--library-line); border-radius: 1rem; background: color-mix(in srgb, var(--primary) 3%, var(--card-bg)); }
	.editor-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
	.editor-head span { color: var(--primary); font-size: .7rem; font-weight: 800; letter-spacing: .1em; }
	.editor-head h2 { margin: .3rem 0 0; color: var(--library-text); font-size: 1.35rem; }
	.field { display: flex; flex-direction: column; gap: .45rem; min-width: 0; }
	.field > span { color: var(--library-muted); font-size: .74rem; font-weight: 700; }
	.field input, .field textarea, .field select { width: 100%; box-sizing: border-box; border: 1px solid var(--library-line); border-radius: .58rem; padding: .72rem .8rem; background: color-mix(in srgb, var(--card-bg) 96%, var(--primary)); color: var(--library-text); font: inherit; outline: none; resize: vertical; }
	.field input:focus, .field textarea:focus, .field select:focus { border-color: var(--primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 13%, transparent); }
	.field input::placeholder, .field textarea::placeholder { color: var(--library-subtle); }
	.bank-name-field { margin-top: 1.2rem; max-width: 34rem; }
	.question-form { display: grid; grid-template-columns: minmax(8rem, .45fr) minmax(0, 1.55fr) minmax(9rem, .55fr); gap: .9rem; align-items: end; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--library-line); }
	.question-field, .options-field { grid-column: span 2; }
	.add-question { min-height: 2.85rem; border-color: var(--primary); color: var(--primary); }
	.editor-status, .upload-status { min-height: 1.3em; margin: .8rem 0 0; font-size: .78rem; color: var(--primary); }
	.draft-summary { margin-top: .8rem; padding: .75rem .85rem; border-radius: .6rem; background: color-mix(in srgb, var(--primary) 8%, transparent); color: var(--library-muted); font-size: .8rem; }
	.draft-list { display: grid; gap: .55rem; margin-top: .65rem; }
	.draft-item { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: .7rem; padding: .7rem .8rem; border: 1px solid var(--library-line); border-radius: .65rem; }
	.draft-item b { color: var(--primary); font-size: .7rem; }
	.draft-item span { overflow: hidden; color: var(--library-text); font-size: .8rem; text-overflow: ellipsis; white-space: nowrap; }
	.draft-item button { border: 0; background: transparent; color: var(--library-muted); cursor: pointer; }
	.editor-actions { display: flex; justify-content: flex-end; gap: .7rem; margin-top: 1rem; }
	.format-note { margin-top: 1rem; padding: 1rem 1.1rem; border: 1px solid var(--library-line); border-radius: .8rem; background: color-mix(in srgb, var(--primary) 3%, transparent); display: grid; grid-template-columns: minmax(12rem, .55fr) minmax(0, 1.45fr); gap: 1rem; align-items: center; }
	.format-note strong { display: block; font-size: .8rem; color: var(--library-text); }
	.format-note span { display: block; margin-top: .3rem; font-size: .72rem; line-height: 1.5; color: var(--library-muted); }
	.format-note code { padding: .65rem .75rem; border-radius: .5rem; background: rgba(128,120,112,.08); font-size: .68rem; color: var(--library-muted); overflow-x: auto; white-space: nowrap; }
	@media (max-width: 760px) {
		.library-page { padding: 1.1rem; border-radius: 1rem; }
		.bank-card { min-height: 11.5rem; }
		.question-form { grid-template-columns: 1fr; }
		.question-field, .options-field { grid-column: auto; }
		.format-note { grid-template-columns: 1fr; }
	}
	@media (max-width: 440px) {
		.library-page { padding: .9rem; }
		.page-head h1 { font-size: 2rem; }
		.format-note code { display: none; }
		.editor-actions { align-items: stretch; flex-direction: column; }
	}
</style>

<script>
	type QuizType = "single" | "multiple" | "judge";
	type QuizQuestion = { q: string; options: string[]; answer: string };
	type QuizBank = Record<QuizType, QuizQuestion[]>;

	const BANK_KEY = "quiz-current-bank";
	const NAME_KEY = "quiz-current-bank-name";
	const ID_KEY = "quiz-current-bank-id";
	const TYPES: QuizType[] = ["single", "multiple", "judge"];
	const TYPE_NAMES: Record<QuizType, string> = { single: "单选", multiple: "多选", judge: "判断" };
	const emptyBank = (): QuizBank => ({ single: [], multiple: [], judge: [] });
	let draft = emptyBank();

	const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
	const fileInput = byId<HTMLInputElement>("quiz-file");
	const uploadStatus = byId<HTMLElement>("upload-status");
	const editor = byId<HTMLElement>("bank-editor");
	const editorStatus = byId<HTMLElement>("editor-status");
	const bankNameInput = byId<HTMLInputElement>("bank-name");
	const typeInput = byId<HTMLSelectElement>("question-type");
	const questionInput = byId<HTMLTextAreaElement>("question-text");
	const optionsInput = byId<HTMLTextAreaElement>("question-options");
	const answerInput = byId<HTMLInputElement>("question-answer");

	function totalOf(bank: QuizBank) { return TYPES.reduce((sum, type) => sum + bank[type].length, 0); }
	function makeId() { return globalThis.crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(36).slice(2)}`; }
	function asRecord(value: unknown): Record<string, unknown> | null { return value !== null && typeof value === "object" ? value as Record<string, unknown> : null; }

	function normalizeQuestion(type: QuizType, raw: unknown): QuizQuestion | null {
		const item = asRecord(raw);
		if (!item) return null;
		const q = String(item.q ?? item.question ?? "").trim();
		let options = Array.isArray(item.options) ? item.options.map((value) => String(value).trim()).filter(Boolean) : [];
		if (type === "judge" && options.length < 2) options = ["正确", "错误"];
		const answer = [...new Set(String(item.answer ?? "").toUpperCase().match(/[A-F]/g) ?? [])].sort().join("");
		if (!q) throw new Error("存在没有题干的题目");
		if (options.length < 2 || options.length > 6) throw new Error(`“${q.slice(0, 18)}”的选项数量应为 2–6 个`);
		if (!answer || [...answer].some((letter) => letter.charCodeAt(0) - 65 >= options.length)) throw new Error(`“${q.slice(0, 18)}”的答案超出选项范围`);
		if (type !== "multiple" && answer.length !== 1) throw new Error(`“${q.slice(0, 18)}”只能有一个答案`);
		return { q, options, answer };
	}

	function normalizeBank(input: unknown): QuizBank {
		const result = emptyBank();
		if (Array.isArray(input)) {
			input.forEach((raw) => {
				const type = asRecord(raw)?.type;
				if (type === "single" || type === "multiple" || type === "judge") result[type].push(normalizeQuestion(type, raw)!);
			});
		} else {
			const bank = asRecord(input);
			if (bank) TYPES.forEach((type) => {
				if (Array.isArray(bank[type])) bank[type].forEach((raw) => result[type].push(normalizeQuestion(type, raw)!));
			});
		}
		return result;
	}

	function loadCurrent(): QuizBank | null {
		try {
			const value = localStorage.getItem(BANK_KEY);
			return value ? normalizeBank(JSON.parse(value)) : null;
		} catch { return null; }
	}

	function renderCurrent() {
		const bank = loadCurrent();
		const card = byId<HTMLElement>("current-bank-card");
		if (!card || !bank || !totalOf(bank)) { if (card) card.hidden = true; return; }
		card.hidden = false;
		const name = byId<HTMLElement>("current-bank-name");
		const summary = byId<HTMLElement>("current-bank-summary");
		if (name) name.textContent = localStorage.getItem(NAME_KEY) || "我的题库";
		if (summary) summary.textContent = `${totalOf(bank)} 题 · 单选 ${bank.single.length} · 多选 ${bank.multiple.length} · 判断 ${bank.judge.length}`;
	}

	function openEditor(bank = emptyBank(), name = "") {
		draft = normalizeBank(bank);
		if (bankNameInput) bankNameInput.value = name;
		if (editor) { editor.hidden = false; editor.scrollIntoView({ behavior: "smooth", block: "start" }); }
		if (editorStatus) editorStatus.textContent = "";
		renderDraft();
	}

	function renderDraft() {
		const list = byId<HTMLElement>("draft-list");
		const summary = byId<HTMLElement>("draft-summary");
		if (!list || !summary) return;
		list.replaceChildren();
		summary.textContent = totalOf(draft) ? `共 ${totalOf(draft)} 题 · 单选 ${draft.single.length} · 多选 ${draft.multiple.length} · 判断 ${draft.judge.length}` : "还没有题目，请先在上方添加。";
		TYPES.forEach((type) => draft[type].forEach((question, index) => {
			const row = document.createElement("div"); row.className = "draft-item";
			const badge = document.createElement("b"); badge.textContent = TYPE_NAMES[type];
			const text = document.createElement("span"); text.textContent = question.q;
			const remove = document.createElement("button"); remove.type = "button"; remove.textContent = "删除";
			remove.addEventListener("click", () => { draft[type].splice(index, 1); renderDraft(); });
			row.append(badge, text, remove); list.append(row);
		}));
	}

	function persistDraft(start: boolean) {
		const total = totalOf(draft);
		if (!total) { if (editorStatus) editorStatus.textContent = "请至少添加一道题目。"; return; }
		const name = bankNameInput?.value.trim() || "我的题库";
		localStorage.setItem(BANK_KEY, JSON.stringify(draft));
		localStorage.setItem(NAME_KEY, name);
		localStorage.setItem(ID_KEY, makeId());
		if (editorStatus) editorStatus.textContent = `“${name}”已保存，共 ${total} 题。`;
		renderCurrent();
		if (start) window.location.href = "/quiz/";
	}

	byId<HTMLButtonElement>("new-bank")?.addEventListener("click", () => openEditor());
	byId<HTMLButtonElement>("edit-bank")?.addEventListener("click", () => {
		const bank = loadCurrent();
		if (bank) openEditor(bank, localStorage.getItem(NAME_KEY) || "我的题库");
	});
	byId<HTMLButtonElement>("cancel-edit")?.addEventListener("click", () => { if (editor) editor.hidden = true; });
	byId<HTMLButtonElement>("clear-bank")?.addEventListener("click", () => {
		if (!window.confirm("确定清空当前题库和它的本地答题记录吗？")) return;
		const bankId = localStorage.getItem(ID_KEY);
		localStorage.removeItem(BANK_KEY); localStorage.removeItem(NAME_KEY); localStorage.removeItem(ID_KEY);
		if (bankId) Object.keys(localStorage).filter((key) => key.startsWith(`quiz-bank-${bankId}-`)).forEach((key) => localStorage.removeItem(key));
		if (editor) editor.hidden = true;
		renderCurrent();
	});

	typeInput?.addEventListener("change", () => {
		const judge = typeInput.value === "judge";
		const optionsField = byId<HTMLElement>("options-field");
		if (optionsField) optionsField.hidden = judge;
		const label = byId<HTMLElement>("answer-label");
		if (label) label.textContent = judge ? "答案（A 正确 / B 错误）" : "答案字母";
		if (answerInput) answerInput.placeholder = judge ? "A 或 B" : typeInput.value === "multiple" ? "例如 AB" : "例如 A";
	});

	byId<HTMLButtonElement>("add-question")?.addEventListener("click", () => {
		try {
			const type = (typeInput?.value || "single") as QuizType;
			const options = type === "judge" ? ["正确", "错误"] : (optionsInput?.value || "").split(/\r?\n/).map((line) => line.trim()).filter(Boolean);
			const question = normalizeQuestion(type, { q: questionInput?.value, options, answer: answerInput?.value });
			if (question) draft[type].push(question);
			if (questionInput) questionInput.value = "";
			if (optionsInput) optionsInput.value = "";
			if (answerInput) answerInput.value = "";
			if (editorStatus) editorStatus.textContent = "题目已添加，可继续录入下一题。";
			renderDraft(); questionInput?.focus();
		} catch (error) { if (editorStatus) editorStatus.textContent = error instanceof Error ? error.message : "题目内容不完整"; }
	});

	byId<HTMLButtonElement>("save-bank")?.addEventListener("click", () => persistDraft(false));
	byId<HTMLButtonElement>("save-and-start")?.addEventListener("click", () => persistDraft(true));

	fileInput?.addEventListener("change", async () => {
		const file = fileInput.files?.[0]; if (!file) return;
		try {
			if (file.size > 4_000_000) throw new Error("题库文件不能超过 4 MB");
			const normalized = normalizeBank(JSON.parse(await file.text()));
			const total = totalOf(normalized);
			if (!total) throw new Error("没有读取到有效题目");
			localStorage.setItem(BANK_KEY, JSON.stringify(normalized));
			localStorage.setItem(NAME_KEY, file.name.replace(/\.json$/i, "") || "我的题库");
			localStorage.setItem(ID_KEY, makeId());
			if (uploadStatus) uploadStatus.textContent = `已读取 ${total} 题，正在进入…`;
			window.setTimeout(() => { window.location.href = "/quiz/"; }, 300);
		} catch (error) {
			if (uploadStatus) uploadStatus.textContent = `导入失败：${error instanceof Error ? error.message : "JSON 格式不正确"}`;
			fileInput.value = "";
		}
	});

	renderCurrent();
</script>
