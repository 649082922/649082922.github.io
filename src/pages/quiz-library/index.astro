---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout title="题库" description="上传 Excel 或 JSON 题库，再开始答题">
	<section class="library-page onload-animation">
		<header class="page-head">
			<p>QUESTION LIBRARY</p>
			<h1>上传题库，直接开始答题</h1>
			<span>不用逐题录入。选择 Excel 或 JSON 文件，网站会自动识别题型、题目、选项和答案；文件只在当前浏览器中处理。</span>
		</header>

		<div class="library-grid">
			<section class="bank-card current" id="current-bank-card" hidden>
				<span class="bank-tag">当前题库</span>
				<strong id="current-bank-name">我的题库</strong>
				<small id="current-bank-summary"></small>
				<div class="card-actions">
					<a class="primary-action" href="/quiz/">继续答题</a>
					<button id="clear-bank" type="button">清空</button>
				</div>
			</section>

			<label class="bank-card upload" for="quiz-file">
				<span class="bank-tag">新建 / 替换题库</span>
				<strong>上传 Excel 题库</strong>
				<small>支持 .xlsx、.xls 和 .json。兼容“类别 / 题目 / 选项 / 答案”四列格式。</small>
				<div class="bank-meta"><b>最大 10 MB</b><i>选择题库文件 →</i></div>
				<input id="quiz-file" type="file" accept=".xlsx,.xls,.json,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,application/json" />
			</label>
		</div>

		<div class="format-note">
			<div>
				<strong>Excel 格式</strong>
				<span>首行为“类别、题目、选项、答案”。类别支持单选、多选、判断；选项用 A—、B—、C— 分隔。</span>
			</div>
			<div class="example-row"><b>单选</b><span>OceanBase 的特点是？</span><code>A— 分布式数据库<br />B— 文本编辑器</code><b>A</b></div>
		</div>

		<div class="upload-progress" id="upload-progress" hidden><span id="progress-label">正在读取题库…</span><i></i></div>
		<p class="upload-status" id="upload-status" aria-live="polite"></p>
	</section>
</MainGridLayout>

<style>
	.library-page {
		--library-text: #25211e;
		--library-muted: #746d65;
		--library-subtle: #948b82;
		--library-line: rgba(37, 33, 30, 0.14);
		--library-on-primary: #2b1118;
		padding: clamp(1.2rem, 3vw, 2.6rem);
		border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent);
		border-radius: 1.35rem;
		background: var(--card-bg);
		color: var(--library-text);
	}
	:global(.dark) .library-page {
		--library-text: #fffaf7;
		--library-muted: #ded3dc;
		--library-subtle: #c5b9c6;
		--library-line: rgba(255, 250, 247, 0.26);
		--library-on-primary: #261017;
		background: rgba(40, 32, 48, 0.9);
	}
	[hidden] { display: none !important; }
	.page-head { max-width: 58rem; }
	.page-head p { margin: 0 0 .8rem; color: var(--primary); font: 800 .72rem/1 ui-monospace, Consolas, monospace; letter-spacing: .14em; }
	.page-head h1 { margin: 0; font-size: clamp(2rem, 5vw, 3.6rem); line-height: 1.08; letter-spacing: -.05em; color: var(--library-text); }
	.page-head > span { display: block; margin-top: 1rem; font-size: .95rem; line-height: 1.75; color: var(--library-muted); }
	.library-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: clamp(.8rem, 1.6vw, 1.2rem); margin-top: clamp(1.6rem, 3vw, 2.4rem); }
	.bank-card { min-height: 15rem; padding: clamp(1.2rem, 2.2vw, 1.8rem); border: 1px solid var(--library-line); border-radius: 1rem; background: color-mix(in srgb, var(--card-bg) 94%, var(--primary)); color: var(--library-text); text-align: left; cursor: pointer; display: flex; flex-direction: column; font: inherit; transition: transform 160ms ease, border-color 160ms ease, background 160ms ease; }
	:global(.dark) .bank-card { background: rgba(55, 45, 64, 0.94); }
	.bank-card:hover { transform: translateY(-2px); border-color: var(--primary); background: color-mix(in srgb, var(--primary) 6%, var(--card-bg)); }
	:global(.dark) .bank-card:hover { background: rgba(64, 51, 72, 0.98); }
	.bank-card.current { cursor: default; }
	.bank-tag { width: max-content; padding: .34rem .58rem; border-radius: .4rem; background: color-mix(in srgb, var(--primary) 13%, transparent); color: var(--primary); font-size: .68rem; font-weight: 800; }
	.bank-card strong { margin-top: 1.25rem; font-size: clamp(1.2rem, 2vw, 1.5rem); color: var(--library-text); }
	.bank-card small { max-width: 36rem; margin-top: .65rem; font-size: .84rem; line-height: 1.7; color: var(--library-muted); }
	.bank-meta, .card-actions { margin-top: auto; padding-top: 1.35rem; display: flex; align-items: center; justify-content: space-between; gap: .7rem; font-size: .76rem; }
	.bank-meta b { color: var(--library-subtle); font-weight: 650; }
	.bank-meta i { color: var(--primary); font-style: normal; font-weight: 800; }
	.bank-card input { display: none; }
	.card-actions { justify-content: flex-start; }
	.card-actions a, .card-actions button { border: 1px solid var(--library-line); border-radius: .55rem; padding: .66rem .88rem; background: transparent; color: var(--library-text); cursor: pointer; font-family: inherit; font-size: .76rem; font-weight: 750; line-height: 1; text-decoration: none; }
	.card-actions button:hover { border-color: color-mix(in srgb, var(--library-text) 55%, transparent); background: rgba(255, 255, 255, 0.06); }
	.primary-action { border-color: var(--primary) !important; background: var(--primary) !important; color: var(--library-on-primary) !important; font-weight: 850 !important; }
	.primary-action:hover { filter: brightness(1.08) saturate(1.05); }
	.format-note { margin-top: 1rem; padding: 1rem 1.1rem; border: 1px solid var(--library-line); border-radius: .8rem; background: color-mix(in srgb, var(--primary) 3%, transparent); display: grid; grid-template-columns: minmax(14rem, .6fr) minmax(0, 1.4fr); gap: 1rem; align-items: center; }
	.format-note strong { display: block; font-size: .82rem; color: var(--library-text); }
	.format-note span { display: block; margin-top: .32rem; font-size: .74rem; line-height: 1.55; color: var(--library-muted); }
	.example-row { display: grid; grid-template-columns: auto minmax(8rem, 1fr) minmax(11rem, 1.5fr) auto; gap: .6rem; align-items: center; padding: .65rem .75rem; border-radius: .55rem; background: rgba(128,120,112,.08); color: var(--library-muted); font-size: .7rem; }
	:global(.dark) .example-row { background: rgba(255, 255, 255, 0.07); }
	.example-row span { margin: 0; }
	.example-row code { color: var(--library-muted); line-height: 1.45; }
	.upload-progress { position: relative; overflow: hidden; margin-top: 1rem; padding: .78rem .9rem; border: 1px solid var(--library-line); border-radius: .65rem; color: var(--library-muted); font-size: .78rem; }
	.upload-progress i { position: absolute; inset: auto 0 0; height: 3px; background: var(--primary); animation: progress 1.2s ease-in-out infinite; transform-origin: left; }
	@keyframes progress { 0% { transform: scaleX(.05); } 50% { transform: scaleX(.72); } 100% { transform: translateX(100%) scaleX(.2); } }
	.upload-status { min-height: 1.3em; margin: .8rem 0 0; font-size: .8rem; line-height: 1.6; color: var(--primary); }
	@media (max-width: 720px) {
		.library-page { padding: 1.1rem; border-radius: 1rem; }
		.bank-card { min-height: 12rem; }
		.format-note { grid-template-columns: 1fr; }
		.example-row { grid-template-columns: auto 1fr auto; }
		.example-row code { grid-column: 1 / -1; }
	}
	@media (max-width: 440px) {
		.library-page { padding: .9rem; }
		.page-head h1 { font-size: 2rem; }
	}
</style>

<script>
	import * as XLSX from "xlsx";

	type QuizType = "single" | "multiple" | "judge";
	type QuizQuestion = { q: string; options: string[]; answer: string };
	type QuizBank = Record<QuizType, QuizQuestion[]>;

	const BANK_KEY = "quiz-current-bank";
	const NAME_KEY = "quiz-current-bank-name";
	const ID_KEY = "quiz-current-bank-id";
	const TYPES: QuizType[] = ["single", "multiple", "judge"];
	const emptyBank = (): QuizBank => ({ single: [], multiple: [], judge: [] });
	const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
	const fileInput = byId<HTMLInputElement>("quiz-file");
	const status = byId<HTMLElement>("upload-status");
	const progress = byId<HTMLElement>("upload-progress");
	const progressLabel = byId<HTMLElement>("progress-label");

	function totalOf(bank: QuizBank) { return TYPES.reduce((sum, type) => sum + bank[type].length, 0); }
	function makeId() { return globalThis.crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(36).slice(2)}`; }
	function cleanText(value: unknown) { return String(value ?? "").replace(/[\u200B-\u200D\uFEFF]/g, "").replace(/\r/g, "").trim(); }
	function cleanQuestion(value: unknown) { return cleanText(value).replace(/\n?\s*选项及标注状态[：:]?\s*$/u, "").trim(); }

	function parseType(value: unknown): QuizType | null {
		const type = cleanText(value).toLowerCase();
		if (type.includes("多选") || type === "multiple") return "multiple";
		if (type.includes("判断") || type === "judge" || type === "true/false") return "judge";
		if (type.includes("单选") || type === "single") return "single";
		return null;
	}

	function parseOptions(value: unknown): string[] {
		const text = cleanText(value);
		const markers = [...text.matchAll(/(?:^|\n)\s*([A-F])(?:\s*[—–－\-.、:：]\s*|\s+)/g)];
		if (markers.length < 2) return text.split(/\n+/).map((line) => line.replace(/^\s*[A-F](?:\s*[—–－\-.、:：]\s*|\s+)/, "").trim()).filter(Boolean);
		return markers.map((match, index) => {
			const start = (match.index ?? 0) + match[0].length;
			const end = index + 1 < markers.length ? markers[index + 1].index : text.length;
			return text.slice(start, end).trim();
		}).filter(Boolean);
	}

	function normalizeAnswer(value: unknown) {
		return [...new Set(cleanText(value).toUpperCase().match(/[A-F]/g) ?? [])].sort().join("");
	}

	function addQuestion(bank: QuizBank, type: QuizType, qValue: unknown, optionsValue: unknown, answerValue: unknown, row: number) {
		const q = cleanQuestion(qValue);
		const options = Array.isArray(optionsValue) ? optionsValue.map(cleanText).filter(Boolean) : parseOptions(optionsValue);
		const answer = normalizeAnswer(answerValue);
		if (!q) throw new Error(`第 ${row} 行缺少题目`);
		if (options.length < 2 || options.length > 6) throw new Error(`第 ${row} 行识别到 ${options.length} 个选项，应为 2–6 个`);
		if (!answer || [...answer].some((letter) => letter.charCodeAt(0) - 65 >= options.length)) throw new Error(`第 ${row} 行答案“${answer || "空"}”无效`);
		if (type !== "multiple" && answer.length !== 1) throw new Error(`第 ${row} 行只能有一个答案`);
		bank[type].push({ q, options, answer });
	}

	function bankFromRows(rows: unknown[][]): QuizBank {
		const bank = emptyBank();
		const headerIndex = rows.findIndex((row) => {
			const cells = row.map(cleanText);
			return cells.some((cell) => /^(类别|题型|类型)$/u.test(cell)) && cells.some((cell) => /^(题目|问题|题干)$/u.test(cell)) && cells.some((cell) => /^选项$/u.test(cell)) && cells.some((cell) => /^答案$/u.test(cell));
		});
		if (headerIndex < 0) throw new Error("没有找到“类别 / 题目 / 选项 / 答案”表头");
		const headers = rows[headerIndex].map(cleanText);
		const findColumn = (pattern: RegExp) => headers.findIndex((cell) => pattern.test(cell));
		const typeColumn = findColumn(/^(类别|题型|类型)$/u);
		const questionColumn = findColumn(/^(题目|问题|题干)$/u);
		const optionsColumn = findColumn(/^选项$/u);
		const answerColumn = findColumn(/^答案$/u);
		const errors: string[] = [];
		rows.slice(headerIndex + 1).forEach((row, index) => {
			if (!row.some((cell) => cleanText(cell))) return;
			const type = parseType(row[typeColumn]);
			if (!type) { errors.push(`第 ${headerIndex + index + 2} 行题型无法识别`); return; }
			try { addQuestion(bank, type, row[questionColumn], row[optionsColumn], row[answerColumn], headerIndex + index + 2); }
			catch (error) { errors.push(error instanceof Error ? error.message : `第 ${headerIndex + index + 2} 行格式错误`); }
		});
		if (errors.length) throw new Error(`${errors[0]}${errors.length > 1 ? `；另有 ${errors.length - 1} 行未通过校验` : ""}`);
		return bank;
	}

	function bankFromJson(input: unknown): QuizBank {
		const bank = emptyBank();
		if (Array.isArray(input)) {
			input.forEach((item, index) => {
				if (!item || typeof item !== "object") return;
				const data = item as Record<string, unknown>;
				const type = parseType(data.type ?? data.category ?? data["类别"]);
				if (type) addQuestion(bank, type, data.q ?? data.question ?? data["题目"], data.options ?? data["选项"], data.answer ?? data["答案"], index + 1);
			});
		} else if (input && typeof input === "object") {
			const data = input as Record<string, unknown>;
			TYPES.forEach((type) => {
				if (Array.isArray(data[type])) data[type].forEach((item, index) => {
					const question = item as Record<string, unknown>;
					addQuestion(bank, type, question.q ?? question.question, question.options, question.answer, index + 1);
				});
			});
		}
		return bank;
	}

	async function readBank(file: File): Promise<QuizBank> {
		if (/\.json$/i.test(file.name)) return bankFromJson(JSON.parse(await file.text()));
		const workbook = XLSX.read(await file.arrayBuffer(), { type: "array" });
		for (const sheetName of workbook.SheetNames) {
			const rows = XLSX.utils.sheet_to_json<unknown[]>(workbook.Sheets[sheetName], { header: 1, raw: false, defval: "" });
			try { return bankFromRows(rows); } catch (error) {
				if (error instanceof Error && !error.message.includes("没有找到")) throw error;
			}
		}
		throw new Error("所有工作表中都没有找到可识别的题库表头");
	}

	function loadCurrent(): QuizBank | null {
		try { const value = localStorage.getItem(BANK_KEY); return value ? bankFromJson(JSON.parse(value)) : null; }
		catch { return null; }
	}

	function renderCurrent() {
		const bank = loadCurrent();
		const card = byId<HTMLElement>("current-bank-card");
		if (!card || !bank || !totalOf(bank)) { if (card) card.hidden = true; return; }
		card.hidden = false;
		const name = byId<HTMLElement>("current-bank-name");
		const summary = byId<HTMLElement>("current-bank-summary");
		if (name) name.textContent = localStorage.getItem(NAME_KEY) || "我的题库";
		if (summary) summary.textContent = `${totalOf(bank)} 题 · 单选 ${bank.single.length} · 多选 ${bank.multiple.length} · 判断 ${bank.judge.length}`;
	}

	byId<HTMLButtonElement>("clear-bank")?.addEventListener("click", () => {
		if (!window.confirm("确定清空当前题库和它的本地答题记录吗？")) return;
		const bankId = localStorage.getItem(ID_KEY);
		localStorage.removeItem(BANK_KEY); localStorage.removeItem(NAME_KEY); localStorage.removeItem(ID_KEY);
		if (bankId) Object.keys(localStorage).filter((key) => key.startsWith(`quiz-bank-${bankId}-`)).forEach((key) => localStorage.removeItem(key));
		renderCurrent();
	});

	fileInput?.addEventListener("change", async () => {
		const file = fileInput.files?.[0];
		if (!file) return;
		try {
			if (file.size > 10_000_000) throw new Error("题库文件不能超过 10 MB");
			if (progress) progress.hidden = false;
			if (progressLabel) progressLabel.textContent = `正在识别 ${file.name}…`;
			if (status) status.textContent = "";
			await new Promise((resolve) => window.setTimeout(resolve, 40));
			const bank = await readBank(file);
			const total = totalOf(bank);
			if (!total) throw new Error("没有读取到有效题目");
			localStorage.setItem(BANK_KEY, JSON.stringify(bank));
			localStorage.setItem(NAME_KEY, file.name.replace(/\.(xlsx?|json)$/i, "") || "我的题库");
			localStorage.setItem(ID_KEY, makeId());
			if (status) status.textContent = `识别成功：共 ${total} 题（单选 ${bank.single.length}、多选 ${bank.multiple.length}、判断 ${bank.judge.length}），正在进入答题…`;
			if (progress) progress.hidden = true;
			window.setTimeout(() => { window.location.href = "/quiz/"; }, 500);
		} catch (error) {
			if (progress) progress.hidden = true;
			if (status) status.textContent = `导入失败：${error instanceof Error ? error.message : "无法识别文件"}`;
			fileInput.value = "";
		}
	});

	renderCurrent();
</script>
