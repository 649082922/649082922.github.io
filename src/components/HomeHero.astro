---
---

<section class="home-hero onload-animation">
	<div class="hero-copy">
		<h1>把生产事故，<br />写成下一次的解法。</h1>
		<p class="intro">
			OceanBase、Oracle 与 MySQL 的真实排障记录、可复用命令，
			以及一套 654 题的 OBCP 练习。
		</p>
		<div class="hero-actions">
			<a class="action primary" href="/quiz-library/">开始刷题</a>
			<a class="action secondary" href="/archive/">翻阅实战笔记</a>
		</div>
	</div>

	<div class="orbit-scene" aria-label="数据库知识轨道：Oracle、MySQL、OceanBase 与 OBCP 题库">
		<div class="orbit-ring ring-outer" aria-hidden="true"><i></i></div>
		<div class="orbit-ring ring-middle" aria-hidden="true"><i></i></div>
		<div class="orbit-ring ring-inner" aria-hidden="true"></div>

		<span class="orbit-node node-oracle"><i></i>Oracle</span>
		<span class="orbit-node node-mysql"><i></i>MySQL</span>
		<span class="orbit-node node-oceanbase"><i></i>OceanBase</span>

		<a class="orbit-core" href="/archive/" aria-label="进入数据库实战知识库">
			<svg viewBox="0 0 32 32" aria-hidden="true">
				<ellipse cx="16" cy="8" rx="10" ry="4.5"></ellipse>
				<path d="M6 8v8c0 2.5 4.5 4.5 10 4.5s10-2 10-4.5V8"></path>
				<path d="M6 16v8c0 2.5 4.5 4.5 10 4.5s10-2 10-4.5v-8"></path>
			</svg>
			<strong>实战知识库</strong>
			<span>先定位，再动手</span>
		</a>

		<a class="quiz-satellite" href="/quiz-library/" aria-label="进入 OBCP 654 道题库">
			<strong>OBCP</strong>
			<span>654 道练习</span>
		</a>
	</div>
</section>

<div class="section-label onload-animation">
	<h2>最近笔记</h2>
	<a href="/archive/">查看全部笔记</a>
</div>

<style>
	.home-hero,
	.section-label {
		--hero-text: #171923;
		--hero-muted: #656977;
		--hero-line: rgba(32, 37, 54, 0.1);
		--hero-surface: rgba(255, 255, 255, 0.82);
		--orbit-blue: #6c8df6;
		--orbit-violet: #9a83e8;
		color: var(--hero-text);
	}
	:global(.dark) .home-hero,
	:global(.dark) .section-label {
		--hero-text: #f2f3f8;
		--hero-muted: #a8adbd;
		--hero-line: rgba(226, 231, 255, 0.12);
		--hero-surface: rgba(24, 27, 38, 0.82);
		--orbit-blue: #91a9ff;
		--orbit-violet: #b6a3ff;
	}
	.home-hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(20rem, 0.75fr);
		align-items: center;
		min-height: 27rem;
		margin-bottom: 1.5rem;
		padding: clamp(2rem, 4vw, 3.75rem);
		overflow: hidden;
		border: 1px solid var(--hero-line);
		border-radius: 1.75rem;
		background: var(--hero-surface);
		box-shadow: 0 2rem 5rem -3.5rem rgba(43, 48, 76, 0.5);
		backdrop-filter: blur(18px);
	}
	.hero-copy {
		position: relative;
		z-index: 2;
	}
	h1 {
		max-width: 12em;
		margin: 0;
		color: var(--hero-text);
		font-size: clamp(2.25rem, 3.8vw, 3.6rem);
		font-weight: 760;
		line-height: 1.18;
		letter-spacing: -0.055em;
	}
	.intro {
		max-width: 35rem;
		margin: 1.5rem 0 2rem;
		color: var(--hero-muted);
		font-size: 1rem;
		line-height: 1.9;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.85rem;
	}
	.action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.9rem;
		padding: 0 1.35rem;
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 700;
		transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
	}
	.action.primary {
		background: var(--primary);
		color: var(--deep-text);
		box-shadow: 0 0.75rem 1.8rem -1rem color-mix(in srgb, var(--primary) 80%, transparent);
	}
	.action.secondary {
		border: 1px solid var(--hero-line);
		background: color-mix(in srgb, var(--hero-surface) 72%, transparent);
		color: var(--hero-text);
	}
	.action:hover {
		transform: translateY(-2px);
	}
	.action.primary:hover {
		box-shadow: 0 1rem 2rem -0.9rem color-mix(in srgb, var(--primary) 85%, transparent);
	}
	.action.secondary:hover {
		background: var(--hero-surface);
	}
	.orbit-scene {
		position: relative;
		min-height: 21rem;
		isolation: isolate;
	}
	.orbit-ring {
		position: absolute;
		top: 50%;
		left: 50%;
		border: 1px solid var(--hero-line);
		border-radius: 50%;
		pointer-events: none;
	}
	.ring-outer {
		width: 112%;
		height: 68%;
		transform: translate(-50%, -50%) rotate(-17deg);
		animation: orbit-breathe 24s linear infinite;
	}
	.ring-middle {
		width: 88%;
		height: 82%;
		transform: translate(-50%, -50%) rotate(39deg);
		border-color: color-mix(in srgb, var(--orbit-blue) 23%, transparent);
	}
	.ring-inner {
		width: 67%;
		height: 54%;
		transform: translate(-50%, -50%) rotate(-43deg);
		border-color: color-mix(in srgb, var(--primary) 22%, transparent);
	}
	.orbit-ring i {
		position: absolute;
		top: 50%;
		left: -0.27rem;
		width: 0.55rem;
		height: 0.55rem;
		margin-top: -0.27rem;
		border: 2px solid var(--hero-surface);
		border-radius: 50%;
		background: var(--primary);
		box-shadow: 0 0 0 0.3rem color-mix(in srgb, var(--primary) 12%, transparent);
	}
	.ring-middle i {
		top: 12%;
		right: 12%;
		left: auto;
		background: var(--orbit-blue);
		box-shadow: 0 0 0 0.3rem color-mix(in srgb, var(--orbit-blue) 12%, transparent);
	}
	.orbit-core {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 2;
		display: flex;
		width: 10rem;
		height: 10rem;
		transform: translate(-50%, -50%);
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--hero-line);
		border-radius: 50%;
		background: var(--hero-surface);
		box-shadow: 0 1.5rem 3.5rem -1.8rem rgba(40, 45, 70, 0.45);
		text-align: center;
		backdrop-filter: blur(16px);
	}
	.orbit-core svg {
		width: 1.8rem;
		height: 1.8rem;
		margin-bottom: 0.6rem;
		fill: none;
		stroke: var(--primary);
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.35;
	}
	.orbit-core strong {
		font-size: 0.9rem;
		font-weight: 750;
	}
	.orbit-core span {
		margin-top: 0.35rem;
		color: var(--hero-muted);
		font-size: 0.67rem;
	}
	.orbit-node,
	.quiz-satellite {
		position: absolute;
		z-index: 3;
		display: inline-flex;
		align-items: center;
		border: 1px solid var(--hero-line);
		background: var(--hero-surface);
		box-shadow: 0 0.65rem 1.6rem -1.2rem rgba(40, 45, 70, 0.45);
		backdrop-filter: blur(12px);
	}
	.orbit-node {
		gap: 0.45rem;
		padding: 0.5rem 0.75rem;
		border-radius: 999px;
		color: var(--hero-muted);
		font-size: 0.72rem;
		font-weight: 650;
	}
	.orbit-node i {
		width: 0.38rem;
		height: 0.38rem;
		border-radius: 50%;
		background: var(--primary);
	}
	.node-oracle { top: 8%; right: 3%; }
	.node-oracle i { background: var(--primary); }
	.node-mysql { top: 43%; left: -2%; }
	.node-mysql i { background: var(--orbit-blue); }
	.node-oceanbase { right: 1%; bottom: 14%; }
	.node-oceanbase i { background: var(--orbit-violet); }
	.quiz-satellite {
		bottom: 2%;
		left: 7%;
		flex-direction: column;
		align-items: flex-start;
		padding: 0.75rem 0.9rem;
		border-radius: 0.9rem;
	}
	.quiz-satellite strong {
		color: var(--hero-text);
		font-size: 0.75rem;
	}
	.quiz-satellite span {
		margin-top: 0.2rem;
		color: var(--hero-muted);
		font-size: 0.68rem;
	}
	.orbit-core:hover,
	.quiz-satellite:hover {
		border-color: color-mix(in srgb, var(--primary) 40%, transparent);
	}
	.section-label {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 0.25rem 0.9rem;
	}
	.section-label h2 {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 750;
		letter-spacing: -0.02em;
	}
	.section-label a {
		color: var(--hero-muted);
		font-size: 0.82rem;
		font-weight: 650;
	}
	.section-label a:hover { color: var(--primary); }
	@keyframes orbit-breathe {
		from { transform: translate(-50%, -50%) rotate(-17deg); }
		to { transform: translate(-50%, -50%) rotate(343deg); }
	}
	@media (max-width: 980px) {
		.home-hero {
			grid-template-columns: minmax(0, 1.1fr) minmax(17rem, 0.9fr);
			padding: 2.25rem;
		}
		h1 { font-size: clamp(2.1rem, 4.6vw, 3rem); }
		.orbit-scene { min-height: 18rem; }
		.orbit-core { width: 8.5rem; height: 8.5rem; }
	}
	@media (max-width: 760px) {
		.home-hero {
			grid-template-columns: 1fr;
			padding: 2rem 1.4rem 1.2rem;
			border-radius: 1.4rem;
		}
		h1 { font-size: clamp(2rem, 8vw, 2.8rem); }
		.intro { margin: 1.2rem 0 1.6rem; font-size: 0.92rem; }
		.orbit-scene { min-height: 17rem; margin-top: 0.75rem; }
		.ring-outer { width: 100%; }
		.node-oracle { right: 7%; }
		.node-mysql { left: 4%; }
		.node-oceanbase { right: 4%; }
		.quiz-satellite { left: 10%; }
		.section-label { padding-right: 0.5rem; padding-left: 0.5rem; }
	}
	@media (max-width: 420px) {
		.hero-actions { align-items: stretch; }
		.action { flex: 1; padding: 0 1rem; }
		.orbit-scene { min-height: 15.5rem; }
		.orbit-core { width: 7.6rem; height: 7.6rem; }
		.orbit-core svg { margin-bottom: 0.4rem; }
		.node-oceanbase { bottom: 18%; }
	}
	@media (prefers-reduced-motion: reduce) {
		.ring-outer { animation: none; }
		.action { transition: none; }
		.action:hover { transform: none; }
	}
</style>
