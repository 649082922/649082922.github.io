---
---

<section class="home-hero onload-animation">
	<div class="hero-copy">
		<p class="eyebrow">DBA FIELD NOTES · 2026</p>
		<h1>把生产事故，<br /><span>写成下一次的解法。</span></h1>
		<p class="intro">这里没有万能提示词，只有 OceanBase、Oracle 与 MySQL 的真实排障记录、可复用命令和一套 654 题的 OBCP 练习。</p>
		<div class="hero-actions">
			<button class="action primary" id="open-quiz-library" type="button">开始刷题 <span>→</span></button>
			<a class="action secondary" href="/archive/">翻阅实战笔记</a>
		</div>
	</div>

	<div class="status-card" aria-label="站点内容概览">
		<div class="status-head">
			<span class="status-dot"></span>
			<span>LEARNING CONSOLE</span>
			<small>ONLINE</small>
		</div>
		<div class="status-main">
			<strong>654</strong>
			<span>道 OBCP 练习题<br />单选 · 多选 · 判断</span>
		</div>
		<div class="status-rows">
			<button class="library-row" id="open-quiz-library-row" type="button"><span>今日建议</span><b>先做 20 题</b><i>↗</i></button>
			<a href="/archive/"><span>技术方向</span><b>数据库运维</b><i>↗</i></a>
			<a href="/talks/"><span>最近更新</span><b>DBA 日常</b><i>↗</i></a>
		</div>
	</div>
</section>

<dialog class="library-dialog" id="quiz-library-dialog">
	<div class="dialog-shell">
		<div class="dialog-head">
			<div><p>QUESTION LIBRARY</p><h2>这次刷哪套题？</h2></div>
			<button class="dialog-close" type="button" aria-label="关闭">×</button>
		</div>
		<div class="library-grid">
			<button class="bank-card built-in" id="start-obcp" type="button">
				<span class="bank-tag">内置题库</span><strong>OBCP v4 认证练习</strong>
				<small>654 题 · 单选 333 · 多选 207 · 判断 114</small><i>直接开始 →</i>
			</button>
			<label class="bank-card upload" for="quiz-file">
				<span class="bank-tag">本地题库</span><strong>上传自己的题库</strong>
				<small>支持 JSON；文件只保存在当前浏览器</small><i>选择文件 ＋</i>
				<input id="quiz-file" type="file" accept=".json,application/json" />
			</label>
		</div>
		<div class="format-note">
			<b>JSON 格式</b>
			<code>{`{"single":[{"q":"题目","options":["A项","B项"],"answer":"A"}],"multiple":[],"judge":[]}`}</code>
		</div>
		<p class="upload-status" id="upload-status" aria-live="polite"></p>
	</div>
</dialog>

<div class="section-label onload-animation">
	<span>最近笔记</span>
	<a href="/archive/">查看全部 →</a>
</div>

<style>
	.home-hero,.section-label { --hero-text:#25211e; --hero-muted:#746d65; --hero-subtle:#948b82; --hero-line:rgba(37,33,30,.12); color:var(--hero-text); }
	:global(.dark) .home-hero,:global(.dark) .section-label { --hero-text:#f5eee8; --hero-muted:#c8bdb4; --hero-subtle:#9f958d; --hero-line:rgba(255,244,235,.14); }
	.home-hero { display:grid; grid-template-columns:minmax(0,1.45fr) minmax(18rem,.55fr); gap:clamp(.75rem,1.4vw,1.25rem); margin-bottom:1.25rem; }
	.hero-copy,.status-card { border:1px solid color-mix(in srgb,var(--primary) 18%,transparent); border-radius:1.35rem; background:var(--card-bg); }
	.hero-copy { padding:clamp(1.6rem,5vw,3.4rem); position:relative; overflow:hidden; }
	.hero-copy:after { content:""; position:absolute; right:-4rem; bottom:-5rem; width:15rem; height:15rem; border:1.5rem solid color-mix(in srgb,var(--primary) 8%,transparent); border-radius:50%; pointer-events:none; }
	.eyebrow { margin:0 0 1.3rem; color:var(--primary); font-size:.72rem; font-weight:800; letter-spacing:.14em; }
	h1 { margin:0; max-width:12ch; font-size:clamp(2.25rem,6vw,4.3rem); line-height:1.03; letter-spacing:-.055em; color:var(--hero-text); }
	h1 span { color:var(--primary); }
	.intro { max-width:52rem; margin:1.4rem 0 1.8rem; font-size:1rem; line-height:1.8; color:var(--hero-muted); }
	.hero-actions { display:flex; flex-wrap:wrap; gap:.75rem; position:relative; z-index:1; }
	.action { display:inline-flex; align-items:center; justify-content:center; min-height:3rem; padding:0 1.2rem; border-radius:.7rem; font-size:.9rem; font-weight:750; }
	.action.primary { border:0; cursor:pointer; background:var(--primary); color:white; }
	.action.primary:hover { filter:brightness(.92); }
	.action.primary span { margin-left:1.8rem; }
	.action.secondary { border:1px solid var(--hero-line); color:var(--hero-text); }
	.status-card { padding:1.1rem; display:flex; flex-direction:column; }
	.status-head { display:flex; align-items:center; gap:.5rem; font:700 .65rem/1 ui-monospace,SFMono-Regular,Consolas,monospace; letter-spacing:.08em; color:var(--hero-subtle); }
	.status-head small { margin-left:auto; color:#2a9d62; }
	.status-dot { width:.5rem; height:.5rem; border-radius:50%; background:#2a9d62; box-shadow:0 0 0 .22rem color-mix(in srgb,#2a9d62 15%,transparent); }
	.status-main { padding:2rem .7rem 1.6rem; display:flex; align-items:flex-end; gap:1rem; }
	.status-main strong { font-size:3.5rem; line-height:.85; letter-spacing:-.08em; color:var(--primary); }
	.status-main span { font-size:.77rem; line-height:1.55; color:var(--hero-muted); }
	.status-rows { margin-top:auto; border-top:1px solid var(--hero-line); }
	.status-rows a,.status-rows .library-row { width:100%; display:grid; grid-template-columns:1fr auto 1rem; align-items:center; gap:.5rem; padding:.9rem .2rem; border:0; border-bottom:1px solid var(--hero-line); background:transparent; text-align:left; font-size:.75rem; color:var(--hero-subtle); cursor:pointer; }
	.status-rows b { color:var(--hero-text); font-weight:650; }
	.status-rows i { font-style:normal; color:var(--primary); }
	.section-label { display:flex; align-items:center; justify-content:space-between; padding:.45rem .2rem .75rem; font-size:.8rem; font-weight:800; letter-spacing:.06em; }
	.section-label a { color:var(--primary); font-weight:650; letter-spacing:0; }
	@media(max-width:980px){ .home-hero{grid-template-columns:1fr}.status-main{padding:1.5rem .4rem}.status-rows{display:grid;grid-template-columns:repeat(3,1fr)}.status-rows a,.status-rows .library-row{grid-template-columns:1fr auto}.status-rows i{display:none} }
	@media(max-width:640px){ .hero-copy{padding:clamp(1.35rem,6vw,1.7rem)}h1{font-size:clamp(2.15rem,11vw,2.8rem)}.intro{font-size:.92rem}.action{flex:1;min-width:9rem}.section-label{padding-left:.65rem;padding-right:.65rem}.status-rows{grid-template-columns:1fr}.status-rows a,.status-rows .library-row{grid-template-columns:1fr auto 1rem}.status-rows i{display:block} }
	.library-dialog { width:min(680px,calc(100% - 24px)); max-height:min(760px,calc(100dvh - 24px)); padding:0; border:0; border-radius:1.25rem; background:var(--card-bg); color:#25211e; box-shadow:0 24px 80px rgba(0,0,0,.28); overflow:auto; }
	:global(.dark) .library-dialog { color:#f5eee8; }
	.library-dialog::backdrop { background:rgba(14,12,10,.62); backdrop-filter:blur(5px); }
	.dialog-shell { padding:1.4rem; }
	.dialog-head { display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:1.1rem; }
	.dialog-head p { margin:0 0 .35rem; color:var(--primary); font:800 .68rem/1 ui-monospace,SFMono-Regular,Consolas,monospace; letter-spacing:.12em; }
	.dialog-head h2 { margin:0; font-size:1.55rem; letter-spacing:-.035em; }
	.dialog-close { width:2.25rem; height:2.25rem; border:1px solid rgba(128,120,112,.25); border-radius:50%; background:transparent; color:currentColor; font-size:1.35rem; cursor:pointer; }
	.library-grid { display:grid; grid-template-columns:1fr 1fr; gap:.8rem; }
	.bank-card { min-height:12rem; padding:1.2rem; border:1px solid rgba(128,120,112,.23); border-radius:.9rem; background:transparent; color:currentColor; text-align:left; cursor:pointer; display:flex; flex-direction:column; }
	.bank-card:hover { border-color:var(--primary); background:color-mix(in srgb,var(--primary) 5%,transparent); }
	.bank-tag { width:max-content; padding:.28rem .5rem; border-radius:.35rem; background:color-mix(in srgb,var(--primary) 12%,transparent); color:var(--primary); font-size:.66rem; font-weight:800; }
	.bank-card strong { margin-top:1.2rem; font-size:1.05rem; }
	.bank-card small { margin-top:.55rem; line-height:1.55; color:#746d65; }
	:global(.dark) .bank-card small { color:#b9afa7; }
	.bank-card i { margin-top:auto; color:var(--primary); font-size:.78rem; font-style:normal; font-weight:750; }
	.bank-card input { display:none; }
	.format-note { margin-top:.9rem; padding:.75rem .85rem; border-radius:.65rem; background:rgba(128,120,112,.08); font-size:.7rem; color:#746d65; overflow:auto; }
	:global(.dark) .format-note { color:#b9afa7; }
	.format-note b { margin-right:.5rem; color:currentColor; }
	.format-note code { white-space:nowrap; }
	.upload-status { min-height:1.2em; margin:.7rem 0 0; font-size:.75rem; color:var(--primary); }
	@media(max-width:580px){.dialog-shell{padding:1rem}.dialog-head h2{font-size:1.3rem}.library-grid{grid-template-columns:1fr}.bank-card{min-height:8.5rem;padding:1rem}.format-note{display:none}}
</style>

<script>
	const dialog = document.getElementById("quiz-library-dialog") as HTMLDialogElement | null;
	const openers = [document.getElementById("open-quiz-library"), document.getElementById("open-quiz-library-row")];
	const openLibrary = () => dialog?.showModal();
	openers.forEach((button) => button?.addEventListener("click", openLibrary));
	dialog?.querySelector(".dialog-close")?.addEventListener("click", () => dialog.close());
	dialog?.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
	document.getElementById("start-obcp")?.addEventListener("click", () => { window.location.href = "/quiz/"; });
	if (window.location.hash === "#quiz-library") openLibrary();
	window.addEventListener("hashchange", () => {
		if (window.location.hash === "#quiz-library") openLibrary();
	});

	const fileInput = document.getElementById("quiz-file") as HTMLInputElement | null;
	const status = document.getElementById("upload-status");
	fileInput?.addEventListener("change", async () => {
		const file = fileInput.files?.[0];
		if (!file) return;
		try {
			if (file.size > 4_000_000) throw new Error("题库文件不能超过 4 MB");
			const parsed = JSON.parse(await file.text());
			const normalized = normalizeBank(parsed);
			const total = normalized.single.length + normalized.multiple.length + normalized.judge.length;
			if (!total) throw new Error("没有读取到题目");
			localStorage.setItem("obcp-custom-bank", JSON.stringify(normalized));
			localStorage.setItem("obcp-custom-bank-name", file.name.replace(/\.json$/i, ""));
			if (status) status.textContent = `已读取 ${total} 题，正在进入…`;
			window.setTimeout(() => { window.location.href = "/quiz/?bank=custom"; }, 350);
		} catch (error) {
			if (status) status.textContent = `导入失败：${error instanceof Error ? error.message : "JSON 格式不正确"}`;
			fileInput.value = "";
		}
	});

	function normalizeBank(input: unknown) {
		const result: Record<"single" | "multiple" | "judge", Array<{q:string;options:string[];answer:string}>> = { single: [], multiple: [], judge: [] };
		const add = (type: "single" | "multiple" | "judge", item: any) => {
			const q = String(item?.q ?? item?.question ?? "").trim();
			const options = Array.isArray(item?.options) ? item.options.map(String) : [];
			const answer = String(item?.answer ?? "").toUpperCase().replace(/[^A-F]/g, "");
			if (q && options.length >= 2 && answer) result[type].push({ q, options, answer });
		};
		if (Array.isArray(input)) input.forEach((item) => { const type = item?.type; if (type in result) add(type, item); });
		else if (input && typeof input === "object") (Object.keys(result) as Array<keyof typeof result>).forEach((type) => { const list = (input as any)[type]; if (Array.isArray(list)) list.forEach((item) => add(type, item)); });
		return result;
	}
</script>
