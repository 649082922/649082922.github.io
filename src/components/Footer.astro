---
import { profileConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-inner">
		<p>
			&copy; <span>{currentYear}</span> {profileConfig.name}
			<span class="footer-note">真实排障，持续记录。</span>
		</p>
		<nav aria-label="页脚链接">
			<a href={url("rss.xml")}>RSS</a>
			<a href={url("sitemap-index.xml")}>Sitemap</a>
			<a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
			<a href="https://github.com/saicaca/fuwari" target="_blank" rel="noopener">Fuwari</a>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		margin: 2.75rem 0 2.25rem;
		padding: 0 1rem;
		color: var(--text-muted);
	}
	.footer-inner {
		display: flex;
		max-width: 72rem;
		margin: 0 auto;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border-subtle);
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.78rem;
	}
	p { margin: 0; }
	.footer-note {
		margin-left: 0.65rem;
		color: var(--text-subtle);
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.9rem;
	}
	a {
		padding: 0.35rem 0;
		color: var(--text-muted);
		font-weight: 600;
	}
	a:hover { color: var(--accent-text); }
	@media (max-width: 640px) {
		.site-footer { margin: 2rem 0 1.5rem; padding: 0 0.5rem; }
		.footer-inner {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.55rem;
		}
		.footer-note { display: block; margin: 0.3rem 0 0; }
		nav { gap: 1rem; }
		a { min-height: 44px; display: inline-flex; align-items: center; }
	}
</style>
