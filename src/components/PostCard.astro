---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
}
const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	category,
	image,
	description,
	style,
} = Astro.props;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";

const coverWidth = "26%";

const { remarkPluginFrontmatter } = await entry.render();
---

<div class:list={["post-card card-base overflow-hidden relative", className]} style={style}>
	<div class="post-card-body">
		<PostMetadata published={published} updated={updated} tags={tags} category={category} hideTagsForMobile={true} hideUpdateDate={true} class="post-card-meta"></PostMetadata>

		<h2 class="post-title">
			<a href={url}>{title}</a>
		</h2>

		<p class="post-desc">{description || remarkPluginFrontmatter.excerpt}</p>

		<div class="post-stats">
			<span>{remarkPluginFrontmatter.words} {i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}</span>
			<span aria-hidden="true">·</span>
			<span>{remarkPluginFrontmatter.minutes} {i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}</span>
		</div>
	</div>

	{hasCover && (
		<a href={url} aria-label={`阅读《${title}》`} class="post-cover group">
			<ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))}
				alt={`${title} 的封面图`} class="h-full w-full">
			</ImageWrapper>
		</a>
	)}
</div>
<div class="post-divider md:hidden" aria-hidden="true"></div>

<style define:vars={{ coverWidth }}>
	.post-card {
		display: flex;
		flex-direction: column-reverse;
		width: 100%;
	}
	@media (min-width: 768px) {
		.post-card { flex-direction: row; }
	}
	.post-card-body {
		position: relative;
		display: flex;
		min-width: 0;
		flex: 1 1 auto;
		flex-direction: column;
		padding: 1.3rem clamp(1.1rem, 2.6vw, 1.9rem);
	}
	.post-card-meta { margin-bottom: 0.7rem; }
	.post-title {
		margin: 0 0 0.55rem;
		font-size: clamp(1.3rem, 2.1vw, 1.62rem);
		font-weight: 750;
		line-height: 1.4;
		letter-spacing: -0.02em;
	}
	.post-title a {
		color: var(--text-strong);
		text-decoration: none;
	}
	.post-title a:hover { color: var(--accent-text); }
	.post-title a:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 3px;
		border-radius: 0.35rem;
	}
	.post-desc {
		display: -webkit-box;
		margin: 0 0 0.8rem;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		color: var(--text-muted);
		font-size: 0.86rem;
		line-height: 1.75;
	}
	.post-stats {
		display: flex;
		margin-top: auto;
		align-items: center;
		gap: 0.55rem;
		color: var(--text-subtle);
		font-size: 0.74rem;
		font-variant-numeric: tabular-nums;
	}
	.post-cover {
		position: relative;
		display: block;
		flex: 0 0 auto;
		overflow: hidden;
		margin: 0.75rem;
		border: 1px solid var(--border-subtle);
		border-radius: 0.9rem;
		max-height: 26vh;
	}
	@media (min-width: 768px) {
		.post-cover {
			width: var(--coverWidth);
			margin: 0.75rem;
			max-height: none;
		}
	}
	.post-cover :global(img) {
		transition: transform var(--duration-base) var(--ease-out);
	}
	.post-cover:hover :global(img) { transform: scale(1.04); }
	.post-cover:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 3px;
	}
	.post-divider {
		margin: 0 1.25rem;
		border-top: 1px dashed var(--border-subtle);
	}
	.post-divider:last-child { border-top: 0; }
	@media (prefers-reduced-motion: reduce) {
		.post-cover :global(img) { transition: none; }
		.post-cover:hover :global(img) { transform: none; }
	}
</style>
