---
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getTagUrl } from "../utils/url-utils";

interface Props {
	class: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	hideTagsForMobile?: boolean;
	hideUpdateDate?: boolean;
}
const {
	published,
	updated,
	tags,
	category,
	hideTagsForMobile = false,
	hideUpdateDate = false,
} = Astro.props;
const className = Astro.props.class;

const showUpdated =
	!hideUpdateDate && updated && updated.getTime() !== published.getTime();
---

<div class:list={["post-meta-row", { "hide-tags-mobile": hideTagsForMobile }, className]}>
	<time datetime={published.toISOString()}>{formatDateToYYYYMMDD(published)}</time>
	{showUpdated && updated && (
		<span class="meta-updated">
			更新于 <time datetime={updated.toISOString()}>{formatDateToYYYYMMDD(updated)}</time>
		</span>
	)}
	<a href={getCategoryUrl(category)} aria-label={`查看 ${category ?? ""} 分类下的全部文章`} class="meta-link">
		{category || i18n(I18nKey.uncategorized)}
	</a>
	<div class:list={["meta-tags", { "mobile-hidden": hideTagsForMobile }]}>
		{tags && tags.length > 0 ? (
			tags.map((tag) => (
				<a href={getTagUrl(tag)} aria-label={`查看包含 ${tag.trim()} 标签的全部文章`} class="meta-link">
					{tag.trim()}
				</a>
			))
		) : (
			<span>{i18n(I18nKey.noTags)}</span>
		)}
	</div>
</div>

<style>
	.post-meta-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 0.8rem;
		color: var(--text-muted);
		font-size: 0.8rem;
		line-height: 1.6;
	}
	.post-meta-row > * + *::before,
	.meta-tags a + a::before {
		content: "·";
		margin-right: 0.8rem;
		color: var(--meta-divider);
	}
	time { font-variant-numeric: tabular-nums; }
	.meta-updated { color: var(--text-subtle); }
	.meta-link {
		color: var(--text-muted);
		font-weight: 600;
		border-radius: 0.35rem;
		white-space: nowrap;
	}
	.meta-link:hover { color: var(--accent-text); }
	.meta-link:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
	}
	.meta-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.8rem; }
	.hide-tags-mobile .meta-tags { display: none; }
	@media (min-width: 768px) {
		.hide-tags-mobile .meta-tags { display: flex; }
	}
	@media (max-width: 767px) {
		.post-meta-row { font-size: 0.78rem; }
	}
</style>
