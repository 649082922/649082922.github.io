---
import type { Page } from "astro";
import { Icon } from "astro-icon/components";
import { url } from "../../utils/url-utils";

interface Props {
	page: Page;
	class?: string;
	style?: string;
}

const { page, style } = Astro.props;

const HIDDEN = -1;

const className = Astro.props.class;

const ADJ_DIST = 2;
const VISIBLE = ADJ_DIST * 2 + 1;

let count = 1;
let l = page.currentPage;
let r = page.currentPage;
while (0 < l - 1 && r + 1 <= page.lastPage && count + 2 <= VISIBLE) {
	count += 2;
	l--;
	r++;
}
while (0 < l - 1 && count < VISIBLE) {
	count++;
	l--;
}
while (r + 1 <= page.lastPage && count < VISIBLE) {
	count++;
	r++;
}

let pages: number[] = [];
if (l > 1) pages.push(1);
if (l === 3) pages.push(2);
if (l > 3) pages.push(HIDDEN);
for (let i = l; i <= r; i++) pages.push(i);
if (r < page.lastPage - 2) pages.push(HIDDEN);
if (r === page.lastPage - 2) pages.push(page.lastPage - 1);
if (r < page.lastPage) pages.push(page.lastPage);

const getPageUrl = (p: number) => {
	if (p === 1) return "/";
	return `/${p}/`;
};
---

<nav class:list={[className, "pagination"]} style={style} aria-label="文章分页">
	{page.url.prev ? (
		<a href={url(page.url.prev)} aria-label="上一页" class="page-arrow">
			<Icon name="material-symbols:chevron-left-rounded" class="text-[1.75rem]"></Icon>
		</a>
	) : (
		<span class="page-arrow" aria-hidden="true" inert>
			<Icon name="material-symbols:chevron-left-rounded" class="text-[1.75rem]"></Icon>
		</span>
	)}

	<div class="page-list">
		{pages.map((p) => {
			if (p == HIDDEN)
				return <span class="page-ellipsis" aria-hidden="true">…</span>;
			if (p == page.currentPage)
				return (
					<span aria-current="page" class="page-item current">
						{p}
					</span>
				);
			return (
				<a href={url(getPageUrl(p))} aria-label={`第 ${p} 页`} class="page-item">
					{p}
				</a>
			);
		})}
	</div>

	{page.url.next ? (
		<a href={url(page.url.next)} aria-label="下一页" class="page-arrow">
			<Icon name="material-symbols:chevron-right-rounded" class="text-[1.75rem]"></Icon>
		</a>
	) : (
		<span class="page-arrow" aria-hidden="true" inert>
			<Icon name="material-symbols:chevron-right-rounded" class="text-[1.75rem]"></Icon>
		</span>
	)}
</nav>

<style>
	.pagination {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
	}
	.page-list {
		display: flex;
		flex-direction: row;
		align-items: center;
		border: 1px solid var(--border-subtle);
		border-radius: 0.85rem;
		background: var(--card-bg);
		box-shadow: var(--shadow-card);
		padding: 0.25rem;
	}
	.page-item,
	.page-arrow {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.65rem;
		color: var(--text-muted);
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}
	.page-arrow {
		border: 1px solid var(--border-subtle);
		background: var(--card-bg);
		box-shadow: var(--shadow-card);
		color: var(--text-muted);
	}
	.page-arrow[href]:hover {
		color: var(--accent-text);
		border-color: var(--border-strong);
	}
	.page-arrow:not([href]) { opacity: 0.35; }
	.pagination a:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 2px;
	}
	.page-item:hover {
		background: var(--btn-plain-bg-hover);
		color: var(--accent-text);
	}
	.page-item.current {
		background: var(--primary);
		color: var(--on-accent);
	}
	.page-ellipsis {
		min-width: 1.4rem;
		text-align: center;
		color: var(--text-subtle);
	}
	@media (max-width: 480px) {
		.pagination { gap: 0.4rem; }
		.page-item, .page-arrow { width: 2.35rem; height: 2.35rem; }
		.page-ellipsis { min-width: 1rem; }
		.page-list { padding: 0.2rem; }
	}
</style>
