<section class="cloud-panel" aria-labelledby="cloud-title">
	<div class="cloud-copy">
		<p class="cloud-kicker">CLOUD SAVE</p>
		<h2 id="cloud-title">登录后长期保存游戏进度</h2>
		<p id="cloud-description">本地存档仍然保留；登录后可以手动上传到云端，并在其他设备恢复。</p>
	</div>

	<div class="cloud-actions" id="cloud-actions">
		<p class="cloud-hint">点击右上角 <strong>人像图标</strong> 登录 GitHub，即可开启云存档。</p>
	</div>

	<div class="user-panel" id="user-panel" hidden>
		<div>
			<span>已登录</span>
			<strong id="user-identity"></strong>
		</div>
		<div class="user-actions">
			<button class="cloud-button primary" id="upload-save" type="button">上传当前存档</button>
			<button class="cloud-button secondary" id="restore-save" type="button">恢复云端存档</button>
			<button class="text-button" id="logout" type="button">退出登录</button>
		</div>
	</div>

	<p class="cloud-status" id="cloud-status" aria-live="polite"></p>
	<p class="privacy-note">登录后会记录登录、存档上传和恢复事件，仅供站长安全审计；不记录游戏操作内容。</p>
</section>

<style>
	.cloud-panel {
		margin-bottom: 1.25rem;
		padding: clamp(1rem, 2.2vw, 1.4rem);
		border: 1px solid var(--border-subtle);
		border-radius: 1rem;
		background: var(--surface-muted);
		box-shadow: var(--shadow-card);
		color: var(--text-strong);
	}
	.cloud-kicker {
		margin: 0 0 0.35rem;
		color: var(--accent-text);
		font-size: 0.76rem;
		font-weight: 700;
		line-height: 1.4;
	}
	.cloud-copy h2 {
		margin: 0;
		color: var(--text-strong);
		font-size: 1.08rem;
		font-weight: 750;
		line-height: 1.5;
		letter-spacing: -0.01em;
	}
	.cloud-copy > p:last-child {
		max-width: 48rem;
		margin: 0.45rem 0 0;
		color: var(--text-muted);
		font-size: 0.82rem;
		line-height: 1.7;
	}
	.cloud-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1rem;
	}
	.cloud-hint {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.8rem;
		line-height: 1.65;
	}
	.cloud-hint strong { color: var(--accent-text); }
	.cloud-actions[hidden] { display: none; }
	.cloud-button {
		min-height: 2.75rem;
		padding: 0.65rem 1rem;
		border: 1px solid var(--border-subtle);
		border-radius: 0.7rem;
		background: var(--surface-solid);
		color: var(--text-strong);
		font-family: inherit;
		font-size: 0.8rem;
		font-weight: 700;
		line-height: 1.3;
		cursor: pointer;
		transition:
			background-color var(--duration-fast) ease,
			border-color var(--duration-fast) ease,
			color var(--duration-fast) ease,
			box-shadow var(--duration-fast) ease;
	}
	.cloud-button.github {
		border-color: var(--text-strong);
		background: var(--text-strong);
		color: var(--surface-solid);
	}
	.cloud-button.primary {
		border-color: var(--accent-fill);
		background: var(--accent-fill);
		color: var(--on-accent);
		font-weight: 800;
	}
	.cloud-button.secondary:hover {
		border-color: var(--accent-text);
		color: var(--accent-text);
	}
	.cloud-button.primary:hover { box-shadow: var(--shadow-card); }
	.cloud-button:disabled { cursor: wait; opacity: 0.55; }
	.cloud-button:focus-visible,
	.text-button:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 3px;
	}
	.user-panel {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border-subtle);
	}
	.user-panel[hidden] { display: none; }
	.user-panel > div:first-child { min-width: 0; }
	.user-panel span {
		display: block;
		color: var(--success);
		font-size: 0.72rem;
		font-weight: 700;
	}
	.user-panel strong {
		display: block;
		margin-top: 0.2rem;
		color: var(--text-strong);
		overflow-wrap: anywhere;
	}
	.user-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.5rem;
	}
	.text-button {
		min-height: 2.75rem;
		padding: 0.65rem 1rem;
		border: 1px solid var(--border-subtle);
		border-radius: 0.7rem;
		background: transparent;
		color: var(--text-muted);
		font-family: inherit;
		font-size: 0.78rem;
		font-weight: 700;
		line-height: 1.3;
		cursor: pointer;
		transition:
			border-color var(--duration-fast) ease,
			color var(--duration-fast) ease;
	}
	.text-button:hover {
		border-color: var(--danger);
		color: var(--danger);
	}
	.cloud-status {
		min-height: 1.5em;
		margin: 0.7rem 0 0;
		color: var(--info);
		font-size: 0.78rem;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}
	.privacy-note {
		margin: 0.4rem 0 0;
		color: var(--text-subtle);
		font-size: 0.7rem;
		line-height: 1.6;
	}
	@media (max-width: 640px) {
		.cloud-panel { padding: 1rem; }
		.user-panel {
			align-items: flex-start;
			flex-direction: column;
		}
		.user-actions {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			width: 100%;
			gap: 0.5rem;
		}
		.cloud-button {
			width: 100%;
			padding-inline: 0.65rem;
		}
		.text-button {
			grid-column: 1 / -1;
			width: 100%;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cloud-button,
		.text-button { transition: none; }
	}
</style>

<script>
	import {
		getFreshUser,
		isCloudConfigured,
		restoreCloudSave,
		supabase,
		uploadCloudSave,
		writeAudit,
	} from "@/lib/game-cloud";
	import type { User } from "@supabase/supabase-js";

	const actions = document.getElementById("cloud-actions");
	const userPanel = document.getElementById("user-panel");
	const identity = document.getElementById("user-identity");
	const status = document.getElementById("cloud-status");
	const description = document.getElementById("cloud-description");
	let currentUser: User | null = null;

	function setStatus(message: string, isError = false) {
		if (!status) return;
		status.textContent = message;
		status.style.color = isError ? "#d95b65" : "var(--primary)";
	}

	function renderUser(user: User | null) {
		currentUser = user;
		if (actions) actions.hidden = Boolean(user);
		if (userPanel) userPanel.hidden = !user;
		if (identity) identity.textContent = user?.email ?? user?.user_metadata?.user_name ?? "已登录用户";
		if (description) description.textContent = user ? "本地存档仍然保留；可手动上传到云端，并在其他设备恢复。" : "点击右上角人像图标登录后可上传云端存档。";
	}

	function auditLoginOnce(user: User) {
		if (sessionStorage.getItem("game-login-audited")) return;
		sessionStorage.setItem("game-login-audited", "1");
		void writeAudit(user, "login");
	}

	if (!isCloudConfigured || !supabase) {
		if (description) description.textContent = "云存档正在等待站长完成服务配置，本地自动存档仍然正常。";
		if (actions) actions.hidden = true;
		setStatus("当前仅使用浏览器本地存档。");
	} else {
		const initialUser = await getFreshUser(supabase);
		renderUser(initialUser);
		if (initialUser) auditLoginOnce(initialUser);
		supabase.auth.onAuthStateChange((event, session) => {
			renderUser(session?.user ?? null);
			if (event === "SIGNED_IN" && session?.user) {
				setStatus("登录成功，可以上传或恢复云端存档。 ");
				auditLoginOnce(session.user);
			}
		});
	}

	document.getElementById("upload-save")?.addEventListener("click", async () => {
		if (!currentUser) return;
		try {
			setStatus("正在上传存档…");
			const count = await uploadCloudSave(currentUser);
			setStatus(count ? `已上传 ${count} 个游戏的存档。` : "没有找到可上传的本地存档。");
		} catch (error) {
			setStatus(`上传失败：${error instanceof Error ? error.message : "未知错误"}`, true);
		}
	});

	document.getElementById("restore-save")?.addEventListener("click", async () => {
		if (!currentUser) return;
		try {
			setStatus("正在恢复云端存档…");
			const { restored, updatedAt } = await restoreCloudSave(currentUser);
			if (!restored) return setStatus("云端还没有存档。 ");
			setStatus(`已恢复 ${restored} 个游戏存档（${new Date(updatedAt!).toLocaleString()}），重新进入游戏后生效。`);
			const frame = document.getElementById("gameFrame") as HTMLIFrameElement | null;
			if (frame) frame.src = frame.src;
		} catch (error) {
			setStatus(`恢复失败：${error instanceof Error ? error.message : "未知错误"}`, true);
		}
	});

	document.getElementById("logout")?.addEventListener("click", async () => {
		if (!supabase || !currentUser) return;
		await writeAudit(currentUser, "logout");
		await supabase.auth.signOut();
		setStatus("已退出登录，本地存档不受影响。 ");
	});
</script>
